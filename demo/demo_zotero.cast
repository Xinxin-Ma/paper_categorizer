[0.093, "o", "gor"]
[0.094, "o", "iz"]
[0.095, "o", "er/"]
[0.095, "o", "ru"]
[0.095, "o", "n.s"]
[0.095, "o", "h "]
[0.092, "o", "--z"]
[0.095, "o", "ot"]
[0.092, "o", "ero"]
[0.095, "o", "-s"]
[0.190, "o", "tat"]
[0.095, "o", "us"]
[0.095, "o", "\r\n"]
[0.818, "o", "\r\n"]
[0.007, "o", "=============================="]
