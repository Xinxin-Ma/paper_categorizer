[0.000, "o", "\u001b[0;32m╔════════════════════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;32m║\u001b[0m       \u001b[1;37mPaper Categorizer - Zotero Integration\u001b[0m                  \u001b[0;32m║\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;32m╚════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[1.006, "o", "\u001b[0;34mZotero integration is \u001b[1;33mOFF by default\u001b[0;34m.\u001b[0m\r\n\u001b[0;34mLet's see how to enable it and check the status.\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[1.506, "o", "\u001b[1;37mStep 1: Configure .env to enable Zotero\u001b[0m\r\n\r\n"]
[0.505, "o", "\u001b[0;36m$ \u001b[0m"]
[0.010, "o", "ca"]
[0.188, "o", "t ."]
[0.091, "o", "en"]
[0.095, "o", "v |"]
[0.092, "o", " g"]
[0.091, "o", "rep"]
[0.091, "o", " Z"]
[0.095, "o", "OTE"]
[0.095, "o", "RO"]
[0.095, "o", "\r\n"]
[0.617, "o", "\u001b[0;90m# Zotero Integration (OFF by default)\u001b[0m\r\nZOTERO_ENABLED=true\r\n"]
[0.000, "o", "ZOTERO_DB_PATH=~/Zotero/zotero.sqlite\r\n"]
[0.000, "o", "ZOTERO_STORAGE_PATH=~/Zotero/storage\r\n\r\n"]
[1.510, "o", "\u001b[1;37mStep 2: Check Zotero status\u001b[0m\r\n\r\n"]
[0.510, "o", "\u001b[0;36m$ \u001b[0m"]
