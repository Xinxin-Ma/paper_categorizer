[0.009, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.001, "o", "\r\n"]
[0.000, "o", "\u001b[0;32m╔════════════════════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;32m║\u001b[0m       \u001b[1;37mPaper Categorizer - First Time Setup\u001b[0m                   \u001b[0;32m║\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;32m╚════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[1.004, "o", "\u001b[0;34mFirst, let's initialize the paper categorization system...\u001b[0m\r\n\r\n"]
[1.006, "o", "\u001b[0;36m$ \u001b[0m"]
[0.035, "o", "cd"]
[0.188, "o", " ~/"]
[0.095, "o", "Do"]
[0.092, "o", "cum"]
[0.094, "o", "en"]
[0.094, "o", "ts/"]
[0.094, "o", "Pa"]
[0.091, "o", "per"]
[0.092, "o", "s\r\n"]
[0.814, "o", "\u001b[0;36m$ \u001b[0m"]
[0.009, "o", "./"]
[0.186, "o", "pap"]
[0.095, "o", "er"]
[0.092, "o", "_ca"]
[0.090, "o", "te"]
[0.095, "o", "gor"]
[0.095, "o", "iz"]
[0.092, "o", "er/"]
[0.095, "o", "ru"]
[0.094, "o", "n.s"]
[0.092, "o", "h "]
[0.095, "o", "--i"]
[0.090, "o", "ni"]
[0.093, "o", "t\r\n"]
[0.816, "o", "\r\n"]
[0.005, "o", "===================="]
[0.186, "o", "===================="]
[0.090, "o", "===================="]
[0.093, "o", "\r\n"]
[0.002, "o", "\r\n"]
[0.008, "o", "Paper Categorization"]
[0.188, "o", " System - Setup\r\n"]
[0.002, "o", "\r\n"]
[0.008, "o", "===================="]
[0.188, "o", "===================="]
[0.092, "o", "===================="]
[0.092, "o", "\r\n"]
[0.001, "o", "\r\n"]
[0.310, "o", "\u001b[0;32m[OK]\u001b[0m Created Inbox folder: ~/Documents/Papers/Inbox\r\n"]
[0.004, "o", "     Place your PDFs"]
[0.186, "o", " here, then run: ./p"]
[0.095, "o", "aper_categorizer/run"]
[0.094, "o", ".sh --batch\r\n"]
[0.002, "o", "\r\n"]
[0.508, "o", "\r\n"]
[0.009, "o", "Creating categories."]
[0.183, "o", "json template...\r\n"]
[0.001, "o", "\r\n"]
[0.309, "o", "\u001b[0;32mCreated:\u001b[0m ~/Documents/Papers/paper_categorizer/categories.json\r\n\r\n"]
[0.507, "o", "------------------------------------------------------------\r\n"]
[0.000, "o", "\u001b[1;33mIMPORTANT: Edit categories.json to define your categories!\u001b[0m\r\n"]
[0.000, "o", "------------------------------------------------------------\r\n\r\n"]
[0.517, "o", "The template include"]
[0.190, "o", "s example categories"]
[0.095, "o", ". You should:\r\n"]
[0.001, "o", "\r\n"]
[0.007, "o", "  1. Open categories"]
[0.188, "o", ".json in a text edit"]
[0.097, "o", "or\r\n"]
[0.001, "o", "\r\n"]
[0.006, "o", "  2. Replace example"]
[0.190, "o", " categories with you"]
[0.091, "o", "r own\r\n"]
[0.001, "o", "\r\n"]
[0.006, "o", "  3. Add as many cat"]
[0.190, "o", "egories and subcateg"]
[0.090, "o", "ories as needed\r\n"]
[0.002, "o", "\r\n"]
[0.009, "o", "  4. Run --init agai"]
[0.188, "o", "n to create the fold"]
[0.094, "o", "er structure\r\n"]
[0.000, "o", "\r\n"]
[1.005, "o", "\r\n\u001b[0;34mCategory format example:\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.004, "o", "  {\r\n    \"1\": {\r\n      \"name\": \"1. Deep Learning\",\r\n      \"description\": \"Neural networks and deep learning\",\r\n      \"keywords\": [\"neural network\", \"transformer\"],\r\n      \"subcategories\": {\r\n        \"1.1\": \"1.1 Architectures & Models\"\r\n      }\r\n    }\r\n  }\r\n"]
[0.000, "o", "\r\n"]
[1.007, "o", "\r\n"]
[0.006, "o", "After editing, run:\r\n"]
[0.001, "o", "\r\n"]
[0.000, "o", "  \u001b[0;36m./paper_categorizer/run.sh --init\u001b[0m\r\n\r\n"]
[0.004, "o", "To see your categori"]
[0.188, "o", "es:\r\n"]
[0.001, "o", "\r\n"]
[0.000, "o", "  \u001b[0;36m./paper_categorizer/run.sh --list-categories\u001b[0m\r\n\r\n"]
[1.005, "o", "\r\n"]
[0.000, "o", "\u001b[0;32m============================================================\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;32m  Setup Complete! Your Inbox folder is ready.\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;32m============================================================\u001b[0m\r\n\r\n"]
