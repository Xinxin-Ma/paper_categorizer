# API Keys for Paper Categorization
# Copy this file to .env and fill in at least one API key

# Google Gemini API (recommended - fastest and cheapest)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Default provider (gemini, claude, or openai)
# If not set, will use the first available API key
DEFAULT_PROVIDER=gemini

# Zotero Integration Settings
# Set to true to enable Zotero integration, false to disable
ZOTERO_ENABLED=true

# Zotero Database Path
# macOS default: ~/Zotero/zotero.sqlite
# Windows default: C:\Users\<username>\Zotero\zotero.sqlite
# Linux default: ~/Zotero/zotero.sqlite
ZOTERO_DB_PATH=~/Zotero/zotero.sqlite

# Zotero Storage Path (where attachments are stored)
# macOS default: ~/Zotero/storage
# Windows default: C:\Users\<username>\Zotero\storage
# Linux default: ~/Zotero/storage
ZOTERO_STORAGE_PATH=~/Zotero/storage
